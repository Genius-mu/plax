generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users         User[]
  customers     Customer[]
  verifications Verification[]
  auditLogs     AuditLog[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  email          String       @unique
  passwordHash   String
  fullName       String
  role           String       @default("REVIEWER") // ADMIN, REVIEWER, CUSTOMER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  reviews        Verification[]
  auditLogs      AuditLog[]
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  firstName      String
  lastName       String
  country        String
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id])
  verifications  Verification[]

  @@index([organizationId])
  @@index([organizationId, email])
}

model Verification {
  id                String             @id @default(uuid())
  organizationId    String
  customerId        String
  reviewerId        String?
  status            String             @default("SUBMITTED") // DRAFT, SUBMITTED, PROCESSING, OCR_SCANNING, BIOMETRIC_MATCH, RISK_SCORING, APPROVED, MANUAL_REVIEW, REJECTED, FAILED
  riskScore         Float              @default(0.0)
  riskLevel         String             @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  rejectionReason   String?
  submittedAt       DateTime?
  completedAt       DateTime?

  // Retry & Job Tracking Fields
  attemptCount      Int                @default(0)
  lastAttemptAt     DateTime?
  nextAttemptAt     DateTime?
  lastError         String?

  // Idempotency & Provider Reference Fields
  idempotencyKey    String?
  providerReference String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id])
  customer          Customer               @relation(fields: [customerId], references: [id])
  reviewer          User?                  @relation(fields: [reviewerId], references: [id])
  documents         VerificationDocument[]
  riskSignals       RiskSignal[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, idempotencyKey])
}

model VerificationDocument {
  id             String       @id @default(uuid())
  verificationId String
  type           String       // PASSPORT, DRIVERS_LICENSE, NATIONAL_ID, PROOF_OF_ADDRESS
  storageKey     String
  issueCountry   String
  documentNumber String?
  expiryDate     DateTime?
  ocrVerified    Boolean      @default(false)
  createdAt      DateTime     @default(now())

  verification   Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
}

model RiskSignal {
  id             String       @id @default(uuid())
  verificationId String
  code           String
  severity       String       // LOW, MEDIUM, HIGH, CRITICAL
  description    String
  createdAt      DateTime     @default(now())

  verification   Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String
  targetId       String
  payload        String?      // JSON stringified payload
  ipAddress      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([organizationId, createdAt])
}
